<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>SC3RGBController</AssemblyName>
    <RootNamespace>SC3RGBController</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\fifine_sc3_rgb_plus.ico</ApplicationIcon>
    <AssemblyTitle>FIFINE SC3 RGB+</AssemblyTitle>
    <Product>FIFINE SC3 RGB+</Product>
    <Description>FIFINE SC3 RGB lighting controller</Description>
    <Company>FIFINE SC3 RGB+ Project</Company>
  </PropertyGroup>
  <Import Project="Version.props" />
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Remove="Updater\**\*.cs" />
    <ProjectReference Include="Updater\SC3FirmwareTool.Core\SC3FirmwareTool.Core.csproj" />
    <None Remove="Assets\*.png" />
    <Content Include="Assets\*.png" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets\fifine_sc3_rgb_plus.ico" />
    <Content Include="firmware\candidates\mod14\SC3-V22-RGB-Mod-1.4-Attestation-Candidate.mva" Link="Firmware\SC3-V22-RGB-Mod-1.4-Attestation-Candidate.mva" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="firmware\recovery\SC3_V22_recovery.MVA" Link="Firmware\SC3_V22_recovery.MVA" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
