<Window x:Class="SC3RGBController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SC3RGBController.UI.Controls"
        xmlns:ui="clr-namespace:SC3RGBController.UI"
        Title="FIFINE SC3 RGB+" Icon="Assets/fifine_sc3_rgb_plus.ico" Width="1350" Height="780" MinWidth="1100" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowStyle="None" AllowsTransparency="True"
        ResizeMode="CanResize" Background="Transparent" UseLayoutRounding="True" SnapsToDevicePixels="True"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged">
    <Border x:Name="WindowFrame" CornerRadius="20" BorderThickness="1.4" ClipToBounds="True">
        <Border.BorderBrush>
            <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#FF5A18" Offset="0" />
                <GradientStop Color="#60E877" Offset="0.28" />
                <GradientStop Color="#387BFF" Offset="0.55" />
                <GradientStop Color="#D235FF" Offset="0.76" />
                <GradientStop Color="#FFE15C" Offset="1" />
            </LinearGradientBrush>
        </Border.BorderBrush>
        <Border Background="#000000" CornerRadius="19">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="66" />
                    <RowDefinition Height="1" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="76" />
                </Grid.RowDefinitions>

                <!-- Custom title bar -->
                <Grid Grid.Row="0" Background="#000000" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="28,0,0,0">
                        <Grid Width="25" Height="25" Margin="0,0,12,0">
                            <Image Source="Assets/fifine_sc3_rgb_plus.png" Stretch="Uniform" />
                        </Grid>
                        <TextBlock Text="FIFINE SC3 RGB+" FontSize="16" FontWeight="Medium" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Grid.Column="1" Text="FIFINE SC3 RGB+" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" />
                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource TitleBarButton}" Content="—" Click="MinimizeButton_Click" />
                        <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Content="□" Click="MaximizeButton_Click" />
                        <Button Style="{StaticResource TitleBarButton}" Content="×" FontSize="23" Click="CloseButton_Click" />
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="#202020" />

                <!-- Main workspace -->
                <Grid Grid.Row="2" Margin="26,22,26,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="238" />
                        <ColumnDefinition Width="24" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!-- Device sidebar -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="20,20,20,18">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" /><RowDefinition Height="Auto" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="20" /><RowDefinition Height="1" /><RowDefinition Height="18" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="18" /><RowDefinition Height="1" />
                                <RowDefinition Height="18" /><RowDefinition Height="Auto" /><RowDefinition Height="18" />
                                <RowDefinition Height="Auto" /><RowDefinition Height="12" /><RowDefinition Height="Auto" />
                                <RowDefinition Height="*" /><RowDefinition Height="Auto" /><RowDefinition Height="10" /><RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Real SC3 base with separate dynamic RGB and glow mask layers. -->
                            <Viewbox Grid.Row="0" Height="150" Stretch="Uniform" Margin="0,0,0,8">
                                <Grid Width="1209" Height="875" ClipToBounds="False">
                                    <Image Source="Assets/sc3_mixer_base.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" />
                                    <Rectangle x:Name="MixerGlowOverlay" IsHitTestVisible="False">
                                        <Rectangle.Fill><SolidColorBrush x:Name="MixerGlowBrush" Color="#FF7800" /></Rectangle.Fill>
                                        <Rectangle.OpacityMask><ImageBrush ImageSource="Assets/sc3_rgb_glow_mask.png" Stretch="Fill" /></Rectangle.OpacityMask>
                                    </Rectangle>
                                    <Rectangle x:Name="MixerLightingOverlay" IsHitTestVisible="False">
                                        <Rectangle.Fill><SolidColorBrush x:Name="MixerLightingBrush" Color="#FF7800" /></Rectangle.Fill>
                                        <Rectangle.OpacityMask><ImageBrush ImageSource="Assets/sc3_rgb_mask.png" Stretch="Fill" /></Rectangle.OpacityMask>
                                    </Rectangle>
                                </Grid>
                            </Viewbox>
                            <TextBlock Grid.Row="1" Text="FIFINE SC3" FontSize="22" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,4,0,0" />
                            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,8,0,0">
                                <Ellipse x:Name="StatusDot" Width="10" Height="10" Fill="{StaticResource DisconnectedBrush}" Margin="0,0,8,0" />
                                <TextBlock x:Name="SidebarConnectionText" Text="Checking…" Foreground="{StaticResource SecondaryTextBrush}" FontSize="16" />
                            </StackPanel>
                            <Border Grid.Row="4" Background="#242424" />

                            <Grid Grid.Row="6">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <Grid Width="26" Height="26" VerticalAlignment="Top">
                                    <Ellipse x:Name="DeviceHealthIcon" Stroke="{StaticResource DisconnectedBrush}" StrokeThickness="2" />
                                    <TextBlock Text="✓" FontSize="15" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Grid>
                                <StackPanel Grid.Column="1">
                                    <TextBlock x:Name="DeviceHealthTitle" Text="Device Status" FontSize="14" FontWeight="SemiBold" />
                                    <TextBlock x:Name="DeviceHealthDetail" Text="Checking the device." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                            <Border Grid.Row="8" Background="#242424" />


                            <Button x:Name="LightingButton" Grid.Row="10" Style="{StaticResource SidebarActionButton}"
                                    Background="Transparent" BorderThickness="1" Click="LightingButton_Click">
                                <Grid Height="48">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="34" Height="48">
                                        <Viewbox Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Canvas Width="24" Height="24">
                                                <Path x:Name="LightingIconPath" Stroke="{StaticResource SecondaryTextBrush}" StrokeThickness="2.2"
                                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                                                      Data="M 12,3 L 12,11 M 7.05,5.63 C 4.58,7.22 3,10.01 3,13.2 C 3,18.06 7.03,22 12,22 C 16.97,22 21,18.06 21,13.2 C 21,10.01 19.42,7.22 16.95,5.63" />
                                            </Canvas>
                                        </Viewbox>
                                    </Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock x:Name="LightingTitleText" Text="Lighting" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                        <TextBlock x:Name="LightingDetailText" Text="RGB lighting is on." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Button x:Name="SettingsButton" Grid.Row="12" Style="{StaticResource SidebarActionButton}"
                                    Height="66" MinHeight="66" Padding="7,5" Background="Transparent" BorderThickness="1" Click="SettingsButton_Click">
                                <Grid MinHeight="54">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Border Width="34" MinHeight="54"><TextBlock Text="⚙" FontSize="20" Foreground="{StaticResource SecondaryTextBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="Settings" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                        <TextBlock Text="App and troubleshooting options." Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,4,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Button>

                            <Grid Grid.Row="14" Margin="0,0,0,2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Start with Windows" FontSize="11.5" FontWeight="SemiBold" />
                                    <TextBlock Text="Restore RGB state on boot" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" />
                                </StackPanel>
                                <CheckBox x:Name="StartWithWindowsToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Width="48" Height="25"
                                          Checked="StartWithWindowsToggle_Changed" Unchecked="StartWithWindowsToggle_Changed" />
                            </Grid>

                            <Grid Grid.Row="16">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="1" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                <TextBlock x:Name="FirmwareVersionText" Text="FW: Checking" Foreground="{StaticResource MutedBrush}" FontSize="10.5" />
                                <Border Grid.Column="1" Background="#333333" Margin="8,0" />
                                <TextBlock x:Name="AppVersionText" Grid.Column="2" Text="App: Checking" Foreground="{StaticResource MutedBrush}" FontSize="10.5" HorizontalAlignment="Right" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Main controls -->
                    <Grid x:Name="ContentHost" Grid.Column="2">
                        <Grid x:Name="RgbControlView">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" /><RowDefinition Height="16" /><RowDefinition Height="Auto" />
                            <RowDefinition Height="16" /><RowDefinition Height="82" />
                        </Grid.RowDefinitions>

                        <Border Grid.Row="0" Style="{StaticResource CardStyle}" Padding="16">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="42*" MinWidth="280" />
                                    <ColumnDefinition Width="1" />
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="58*" MinWidth="350" />
                                </Grid.ColumnDefinitions>
                                 <controls:HsvColorPicker x:Name="ColorPicker" Grid.Column="0" Margin="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                          FocusVisualStyle="{x:Null}"
                                                          SelectedColorChanged="ColorPicker_SelectedColorChanged" />
                                <Border Grid.Column="1" Background="#333333" Margin="0,8" />

                                <Grid Grid.Column="3" Margin="4,4,4,2">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="Auto" />
                                        <RowDefinition Height="12" /><RowDefinition Height="Auto" /><RowDefinition Height="2" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="18" /><ColumnDefinition Width="116" /></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="HEX" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,5" />
                                            <Grid Height="42">
                                                <TextBox x:Name="HexBox" Foreground="Transparent" Text="#FF7800" TextChanged="HexBox_TextChanged"
                                                         LostKeyboardFocus="HexBox_LostKeyboardFocus" PreviewKeyDown="InputBox_PreviewKeyDown" MaxLength="7" />
                                                <TextBlock Text="{Binding Text, ElementName=HexBox}" Foreground="{StaticResource TextBrush}" FontSize="15"
                                                           Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False" />
                                            </Grid>
                                        </StackPanel>
                                        <Border x:Name="ColorPreview" Grid.Column="2" Margin="0,22,0,0" Height="52" VerticalAlignment="Top" CornerRadius="9" Background="#FF7800"
                                                BorderBrush="{DynamicResource AccentBrush}" BorderThickness="2">
                                            <Border.Effect><DropShadowEffect x:Name="PreviewGlow" Color="#FF7800" BlurRadius="13" ShadowDepth="0" Opacity="0.42" /></Border.Effect>
                                        </Border>
                                    </Grid>

                                    <UniformGrid Grid.Row="2" Rows="1" Columns="3">
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="R" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" />
                                            <Grid Height="38"><TextBox x:Name="RedBox" Foreground="Transparent" TextChanged="RgbBox_TextChanged" LostKeyboardFocus="RgbBox_LostKeyboardFocus" PreviewKeyDown="InputBox_PreviewKeyDown" MaxLength="3" /><TextBlock Text="{Binding Text, ElementName=RedBox}" Foreground="{StaticResource TextBrush}" FontSize="15" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False" /></Grid>
                                        </StackPanel>
                                        <StackPanel Margin="0,0,12,0">
                                            <TextBlock Text="G" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" />
                                            <Grid Height="38"><TextBox x:Name="GreenBox" Foreground="Transparent" TextChanged="RgbBox_TextChanged" LostKeyboardFocus="RgbBox_LostKeyboardFocus" PreviewKeyDown="InputBox_PreviewKeyDown" MaxLength="3" /><TextBlock Text="{Binding Text, ElementName=GreenBox}" Foreground="{StaticResource TextBrush}" FontSize="15" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False" /></Grid>
                                        </StackPanel>
                                        <StackPanel>
                                            <TextBlock Text="B" FontWeight="SemiBold" FontSize="14" Margin="0,0,0,5" />
                                            <Grid Height="38"><TextBox x:Name="BlueBox" Foreground="Transparent" TextChanged="RgbBox_TextChanged" LostKeyboardFocus="RgbBox_LostKeyboardFocus" PreviewKeyDown="InputBox_PreviewKeyDown" MaxLength="3" /><TextBlock Text="{Binding Text, ElementName=BlueBox}" Foreground="{StaticResource TextBrush}" FontSize="15" Margin="14,0" VerticalAlignment="Center" IsHitTestVisible="False" /></Grid>
                                        </StackPanel>
                                    </UniformGrid>

                                    <Grid Grid.Row="4">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="5" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid><TextBlock Text="Brightness" FontSize="15" FontWeight="SemiBold" /><TextBlock x:Name="BrightnessText" Text="100%" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" /></Grid>
                                        <Grid Grid.Row="2">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="28" /><ColumnDefinition Width="*" /><ColumnDefinition Width="28" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="☼" Foreground="{StaticResource SecondaryTextBrush}" FontSize="17" VerticalAlignment="Center" />
                                            <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" TickFrequency="1"
                                                    Style="{StaticResource BrightnessSlider}" ValueChanged="BrightnessSlider_ValueChanged" Margin="2,0" />
                                            <TextBlock Grid.Column="2" Text="☀" Foreground="{StaticResource SecondaryTextBrush}" FontSize="18" HorizontalAlignment="Right" VerticalAlignment="Center" />
                                        </Grid>
                                    </Grid>

                                    <Grid Grid.Row="6" Margin="0,2,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="6" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="0" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock Text="Effects" FontSize="15" FontWeight="SemiBold" />
                                        <UniformGrid Grid.Row="2" Rows="1" Columns="5">
                                            <Button x:Name="StaticEffectButton" Content="Static" Tag="Static" Style="{StaticResource EffectButton}" Click="EffectButton_Click" Margin="0,0,5,0" />
                                            <Button x:Name="BreathingEffectButton" Content="Breathing" Tag="Breathing" Style="{StaticResource EffectButton}" Click="EffectButton_Click" Margin="0,0,5,0" />
                                            <Button x:Name="RainbowEffectButton" Content="Rainbow" Tag="Rainbow" Style="{StaticResource EffectButton}" Click="EffectButton_Click" Margin="0,0,5,0" />
                                            <Button x:Name="PulseEffectButton" Content="Pulse" Tag="Pulse" Style="{StaticResource EffectButton}" Click="EffectButton_Click" Margin="0,0,5,0" />
                                            <Button x:Name="ColorCycleEffectButton" Content="Color Cycle" Tag="ColorCycle" Style="{StaticResource EffectButton}" Click="EffectButton_Click" />
                                        </UniformGrid>
                                        <Grid x:Name="EffectSpeedPanel" Grid.Row="4" Margin="0,8,0,14" Visibility="Collapsed">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="6" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Grid>
                                                <TextBlock Text="Speed" FontSize="15" FontWeight="SemiBold" />
                                                <TextBlock x:Name="EffectSpeedText" Text="50%" Foreground="{DynamicResource AccentBrush}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                            </Grid>
                                            <Grid Grid.Row="2">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="Slow" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11.5" VerticalAlignment="Center" Margin="0,0,12,0" />
                                                <Slider x:Name="EffectSpeedSlider" Grid.Column="1" Minimum="1" Maximum="100" Value="50" TickFrequency="1"
                                                        Style="{StaticResource BrightnessSlider}" ValueChanged="EffectSpeedSlider_ValueChanged" />
                                                <TextBlock Grid.Column="2" Text="Fast" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="12,0,0,0" />
                                            </Grid>
                                        </Grid>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="8" /><RowDefinition Height="76" /></Grid.RowDefinitions>
                            <Grid>
                                <TextBlock Text="Presets" FontSize="16" FontWeight="SemiBold" Margin="16,0,0,0" />
                                <TextBlock x:Name="PresetHintText" Text="Changes save with Apply" Foreground="{StaticResource MutedBrush}" FontSize="11.5" HorizontalAlignment="Right" VerticalAlignment="Center" />
                            </Grid>
                            <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled" Padding="0,0,3,0">
                                <ScrollViewer.Resources>
                                    <Style TargetType="ScrollBar">
                                        <Setter Property="Height" Value="7" />
                                        <Setter Property="Margin" Value="0,5,0,0" />
                                        <Setter Property="Background" Value="Transparent" />
                                        <Setter Property="Focusable" Value="False" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ScrollBar">
                                                    <Grid Background="Transparent">
                                                        <Track x:Name="PART_Track" IsDirectionReversed="False">
                                                            <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageLeftCommand" Background="Transparent" BorderThickness="0" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton>
                                                            <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageRightCommand" Background="Transparent" BorderThickness="0" Focusable="False"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent" /></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton>
                                                            <Track.Thumb>
                                                                <Thumb Height="4" Margin="0,1" Focusable="False">
                                                                    <Thumb.Template><ControlTemplate TargetType="Thumb"><Border Background="#353535" CornerRadius="2" /></ControlTemplate></Thumb.Template>
                                                                </Thumb>
                                                            </Track.Thumb>
                                                        </Track>
                                                    </Grid>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ScrollViewer.Resources>
                                <StackPanel Orientation="Horizontal">
                                    <ItemsControl x:Name="PresetItemsControl">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Width="132" Height="64" Margin="0,0,10,0" Background="{StaticResource PanelAltBrush}" BorderBrush="{Binding BorderHex}" BorderThickness="{Binding CardBorderThickness}" CornerRadius="10">
                                                    <Grid>
                                                        <Button Tag="{Binding}" Click="PresetCard_Click" Style="{StaticResource PremiumButton}" Background="Transparent" BorderThickness="0" Padding="10,7" HorizontalContentAlignment="Stretch">
                                                            <Grid>
                                                                <Grid.ColumnDefinitions><ColumnDefinition Width="30" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                                <Ellipse Width="23" Height="23" Fill="{Binding Hex}" VerticalAlignment="Center" />
                                                                <StackPanel Grid.Column="1" Margin="7,0,0,0" VerticalAlignment="Center">
                                                                    <TextBlock Text="{Binding DisplayName}" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                    <TextBlock Text="{Binding Brightness, StringFormat={}{0}%}" Foreground="{StaticResource SecondaryTextBrush}" FontSize="11" Margin="0,3,0,0" />
                                                                </StackPanel>
                                                            </Grid>
                                                        </Button>
                                                        <TextBlock Text="•" FontSize="18" Foreground="{Binding Hex}" Visibility="{Binding DirtyVisibility}" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-6,7,0" IsHitTestVisible="False" />
                                                        <Button Tag="{Binding}" Content="×" Style="{StaticResource PresetDeleteButton}" Click="DeletePresetButton_Click" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,3,3,0" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Button x:Name="AddPresetButton" Width="132" Height="64" Style="{StaticResource PremiumButton}" Background="Transparent" BorderBrush="#505050" BorderThickness="1" Padding="8" Click="AddPresetButton_Click">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center"><TextBlock Text="+" FontSize="24" Foreground="{DynamicResource AccentBrush}" Margin="0,-2,8,0" /><TextBlock Text="Add Preset" VerticalAlignment="Center" FontSize="13" /></StackPanel>
                                    </Button>
                                </StackPanel>
                            </ScrollViewer>
                        </Grid>

                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="1*" /><ColumnDefinition Width="16" /><ColumnDefinition Width="1.05*" /></Grid.ColumnDefinitions>
                            <Button x:Name="ApplyButton" Style="{StaticResource AccentButton}" Click="ApplyButton_Click" IsEnabled="False">
                                <StackPanel Orientation="Horizontal"><Border Width="30" Height="30" BorderBrush="White" BorderThickness="2" CornerRadius="15" Margin="0,0,14,0"><TextBlock Text="✓" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border><TextBlock x:Name="ApplyButtonText" Text="Apply" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                            </Button>
                            <Button x:Name="StopButton" Grid.Column="2" Style="{StaticResource PremiumButton}" FontSize="20" Click="StopButton_Click" IsEnabled="False" Background="#151515">
                                <StackPanel Orientation="Horizontal"><Border Width="30" Height="30" BorderBrush="White" BorderThickness="2" CornerRadius="15" Margin="0,0,14,0"><Rectangle Width="11" Height="11" Fill="White" RadiusX="2" RadiusY="2" /></Border><TextBlock Text="Stop" FontSize="20" FontWeight="SemiBold" VerticalAlignment="Center" /></StackPanel>
                            </Button>
                        </Grid>
                    </Grid>
                        <ui:SettingsView x:Name="IntegratedSettingsView" Visibility="Collapsed"
                                         RestoreRequested="IntegratedSettingsView_RestoreRequested"
                                         BackRequested="IntegratedSettingsView_BackRequested"
                                         CheckForUpdatesRequested="IntegratedSettingsView_CheckForUpdatesRequested"
                                         UpdateNowRequested="IntegratedSettingsView_UpdateNowRequested"
                                         CancelDownloadRequested="IntegratedSettingsView_CancelDownloadRequested"
                                         InstallAndRestartRequested="IntegratedSettingsView_InstallAndRestartRequested"
                                         AutomaticUpdateCheckChanged="IntegratedSettingsView_AutomaticUpdateCheckChanged" />
                    </Grid>
                </Grid>

                <!-- Footer -->
                <Border Grid.Row="3" Style="{StaticResource CardStyle}" Margin="26,8,26,12" CornerRadius="14" Padding="20,0">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="16" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="18" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                        <TextBlock Text="⌁" Foreground="{StaticResource ConnectedBrush}" FontSize="25" VerticalAlignment="Center" />
                        <TextBlock x:Name="FooterConnectionText" Grid.Column="2" Text="Checking FIFINE SC3" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13.5" VerticalAlignment="Center" />
                        <Border Grid.Column="3" Width="1" Height="20" Background="#303030" VerticalAlignment="Center" />
                        <StackPanel x:Name="FooterStatusPanel" Grid.Column="4" Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="USB" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
                            <Ellipse Width="5" Height="5" Fill="{StaticResource MutedBrush}" Margin="12,0" />
                            <TextBlock x:Name="FooterReadyText" Text="Checking HID" Foreground="{StaticResource SecondaryTextBrush}" FontSize="13" />
                            <TextBlock x:Name="TransferStatusText" Text="" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="18,1,0,0" TextTrimming="CharacterEllipsis" MaxWidth="310" />
                        </StackPanel>
                        <Border x:Name="UpdateBanner" Grid.Column="4" Visibility="Collapsed" Background="#101510" BorderBrush="{StaticResource ConnectedBrush}" BorderThickness="1" CornerRadius="10" Padding="12,5" Margin="0,4,12,4" MinHeight="44">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="UpdateBannerText" Text="Update available" VerticalAlignment="Center" FontSize="12.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/>
                                <Button Grid.Column="1" Content="Update Now" Height="32" MinWidth="98" Margin="12,0,8,0" Padding="12,4"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="12" Style="{StaticResource PremiumButton}"
                                        Background="#151B17" BorderBrush="{StaticResource ConnectedBrush}" FocusVisualStyle="{x:Null}" Click="UpdateBannerButton_Click"/>
                                <Button Grid.Column="2" Content="Later" Height="32" MinWidth="72" Padding="11,4"
                                        HorizontalContentAlignment="Center" VerticalContentAlignment="Center" FontSize="12" Style="{StaticResource PremiumButton}"
                                        FocusVisualStyle="{x:Null}" Click="UpdateBannerLaterButton_Click"/>
                            </Grid>
                        </Border>
                        <StackPanel Grid.Column="5" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button x:Name="FirmwareSetupButton" Style="{StaticResource PremiumButton}" Background="#FF7800" BorderThickness="0" Padding="12,5" Margin="0,0,12,0" Click="FirmwareSetupButton_Click" Visibility="Collapsed">
                                <TextBlock Text="Enable RGB Control" Foreground="White" FontSize="13" FontWeight="SemiBold" />
                            </Button>
                            <TextBlock Text="Having issues?" Foreground="{StaticResource MutedBrush}" FontSize="12.5" VerticalAlignment="Center" Margin="0,0,14,0" />
                            <Button x:Name="FooterReconnectButton" Style="{StaticResource PremiumButton}" Background="Transparent" BorderThickness="0" Padding="4" Click="ReconnectButton_Click">
                                <TextBlock Text="Reconnect  ›" Foreground="{DynamicResource AccentBrush}" FontSize="13.5" FontWeight="SemiBold" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Border>
</Window>
