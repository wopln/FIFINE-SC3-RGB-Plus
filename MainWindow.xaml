<Window x:Class="SC3RGBController.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:SC3RGBController.UI.Controls"
        xmlns:ui="clr-namespace:SC3RGBController.UI"
        Title="FIFINE SC3 RGB+" Icon="Assets/fifine_sc3_rgb_plus.ico" Width="1240" Height="820" MinWidth="900" MinHeight="580"
        WindowStartupLocation="CenterScreen" ResizeMode="CanResize" Background="{StaticResource WindowBrush}"
        UseLayoutRounding="True" SnapsToDevicePixels="True" TextOptions.TextFormattingMode="Display"
        Loaded="Window_Loaded" Closing="Window_Closing" StateChanged="Window_StateChanged" PreviewKeyDown="Window_PreviewKeyDown">
    <!-- System-drawn frame: edge resizing, Aero Snap, Win+Arrow and Windows 11 rounded corners all work. -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="44" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="WindowFrame" Background="{StaticResource WindowBrush}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Title bar -->
            <Grid Grid.Row="0">
                <Border Height="2" VerticalAlignment="Top" IsHitTestVisible="False">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                            <GradientStop Color="#FF5A18" Offset="0" /><GradientStop Color="#60E877" Offset="0.28" />
                            <GradientStop Color="#387BFF" Offset="0.55" /><GradientStop Color="#D235FF" Offset="0.76" />
                            <GradientStop Color="#FFE15C" Offset="1" />
                        </LinearGradientBrush>
                    </Border.Background>
                </Border>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                    <Image Source="Assets/fifine_sc3_rgb_plus.png" Width="20" Height="20" Margin="0,0,10,0" AutomationProperties.Name="App icon" />
                    <TextBlock Text="FIFINE SC3 RGB+" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Button Style="{StaticResource TitleBarButton}" Content="&#xE921;" Click="MinimizeButton_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="Minimize" ToolTip="Minimize" />
                    <Button x:Name="MaximizeButton" Style="{StaticResource TitleBarButton}" Content="&#xE922;" Click="MaximizeButton_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="Maximize" ToolTip="Maximize" />
                    <Button Style="{StaticResource TitleBarCloseButton}" Content="&#xE8BB;" Click="CloseButton_Click" WindowChrome.IsHitTestVisibleInChrome="True"
                            AutomationProperties.Name="Close" ToolTip="Close" />
                </StackPanel>
            </Grid>

            <!-- Workspace -->
            <Grid Grid.Row="1" Margin="16,4,16,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="232" />
                    <ColumnDefinition Width="16" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Sidebar: device + navigation -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}" Padding="16">
                    <DockPanel LastChildFill="False">
                        <StackPanel DockPanel.Dock="Top" AutomationProperties.Name="Device">
                            <!-- Live preview: base hardware photo with lighting and glow masks tinted by the current color. -->
                            <Viewbox Height="116" Stretch="Uniform" Margin="0,4,0,10" AutomationProperties.Name="Mixer lighting preview">
                                <Grid Width="1209" Height="875">
                                    <Image Source="Assets/sc3_mixer_base.png" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality" AutomationProperties.Name="SC3 mixer preview, lit in the current color" />
                                    <Rectangle x:Name="MixerGlowOverlay" IsHitTestVisible="False">
                                        <Rectangle.Fill><SolidColorBrush x:Name="MixerGlowBrush" Color="#FF7800" /></Rectangle.Fill>
                                        <Rectangle.OpacityMask><ImageBrush ImageSource="Assets/sc3_rgb_glow_mask.png" Stretch="Fill" /></Rectangle.OpacityMask>
                                    </Rectangle>
                                    <Rectangle x:Name="MixerLightingOverlay" IsHitTestVisible="False">
                                        <Rectangle.Fill><SolidColorBrush x:Name="MixerLightingBrush" Color="#FF7800" /></Rectangle.Fill>
                                        <Rectangle.OpacityMask><ImageBrush ImageSource="Assets/sc3_rgb_mask.png" Stretch="Fill" /></Rectangle.OpacityMask>
                                    </Rectangle>
                                </Grid>
                            </Viewbox>
                            <TextBlock Text="FIFINE SC3" FontSize="18" FontWeight="SemiBold" HorizontalAlignment="Center" />
                            <Border HorizontalAlignment="Center" Margin="0,8,0,0" Padding="10,4" CornerRadius="12" Background="{StaticResource PanelAltBrush}">
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{StaticResource MutedBrush}" Margin="0,0,7,0" VerticalAlignment="Center" />
                                    <TextBlock x:Name="SidebarConnectionText" Text="Checking…" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource SecondaryTextBrush}"
                                               AutomationProperties.LiveSetting="Polite" />
                                </StackPanel>
                            </Border>
                            <TextBlock x:Name="DeviceHealthDetail" Text="Looking for your SC3." Style="{StaticResource CaptionText}" TextAlignment="Center" Margin="0,8,0,0" />
                            <Border Height="1" Background="{StaticResource BorderBrush}" Margin="-16,16,-16,12" />
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Top" KeyboardNavigation.DirectionalNavigation="Cycle" AutomationProperties.Name="Main navigation">
                            <RadioButton x:Name="LightingNavItem" AutomationProperties.Name="Lighting" GroupName="MainNav" Style="{StaticResource NavItem}" IsChecked="True" Checked="LightingNavItem_Checked"
                                         ToolTip="Lighting (Ctrl+1)">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE781;" Style="{StaticResource IconText}" Margin="0,0,12,0" /><TextBlock Text="Lighting" FontSize="14.5" /></StackPanel>
                            </RadioButton>
                            <RadioButton x:Name="SettingsNavItem" AutomationProperties.Name="Settings" GroupName="MainNav" Style="{StaticResource NavItem}" Margin="0,4,0,0" Checked="SettingsNavItem_Checked"
                                         ToolTip="Settings (Ctrl+,)">
                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE713;" Style="{StaticResource IconText}" Margin="0,0,12,0" /><TextBlock Text="Settings" FontSize="14.5" /></StackPanel>
                            </RadioButton>
                        </StackPanel>

                        <StackPanel DockPanel.Dock="Bottom">
                            <TextBlock x:Name="FirmwareVersionText" Text="Firmware: checking" Style="{StaticResource CaptionText}" />
                            <TextBlock x:Name="AppVersionText" Text="App: checking" Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Pages -->
                <Grid Grid.Column="2">
                    <ScrollViewer x:Name="RgbControlView" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Focusable="False" Padding="0,0,6,0">
                        <StackPanel>
                            <!-- Page header -->
                            <Grid Margin="4,6,0,14">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Lighting" Style="{StaticResource PageTitleText}" />
                                    <TextBlock x:Name="LightingStatusText" Text="Changes show on your SC3 instantly." Style="{StaticResource CaptionText}" Margin="0,4,0,0" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="StopButton" AutomationProperties.Name="Use FIFINE default lighting" Style="{StaticResource SubtleButton}" Click="StopButton_Click" Margin="0,0,12,0" IsEnabled="False"
                                            ToolTip="Hand lighting back to the mixer's built-in FIFINE effect until you change a color again.">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE777;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" /><TextBlock Text="Use FIFINE default" FontSize="13.5" /></StackPanel>
                                    </Button>
                                    <CheckBox x:Name="LightingSwitch" Style="{StaticResource ToggleSwitch}" Checked="LightingSwitch_Changed" Unchecked="LightingSwitch_Changed" ToolTip="Turn RGB lighting on or off (Ctrl+L)">
                                        <TextBlock Text="RGB lighting" FontSize="14" FontWeight="SemiBold" />
                                    </CheckBox>
                                </StackPanel>
                            </Grid>

                            <!-- Setup required -->
                            <Border x:Name="SetupBar" Style="{StaticResource InfoBarStyle}" Background="{StaticResource WarningBarBackgroundBrush}" BorderBrush="{StaticResource WarningBrush}"
                                    Margin="0,0,0,12" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE7BA;" Style="{StaticResource IconText}" Foreground="{StaticResource WarningBrush}" Margin="0,0,12,0" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock Text="RGB control isn't set up on this SC3 yet" FontWeight="SemiBold" />
                                        <TextBlock Text="A one-time firmware install (about 2 minutes) unlocks colors, effects and Custom A–D buttons. Keep the mixer plugged in directly while it runs." Style="{StaticResource CaptionText}" Margin="0,2,0,0" />
                                    </StackPanel>
                                    <Button x:Name="FirmwareSetupButton" Grid.Column="2" Style="{StaticResource PremiumButton}" Background="{StaticResource WarningBrush}" BorderBrush="{StaticResource WarningBrush}"
                                            Foreground="#000000" Content="Enable RGB control" Margin="16,0,0,0" Click="FirmwareSetupButton_Click" Visibility="Collapsed" />
                                </Grid>
                            </Border>

                            <!-- Lighting off -->
                            <Border x:Name="LightingOffBar" Style="{StaticResource InfoBarStyle}" Margin="0,0,0,12" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                    <TextBlock Text="&#xE946;" Style="{StaticResource IconText}" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,12,0" />
                                    <TextBlock Grid.Column="1" Text="RGB lighting is off. You can still pick colors and edit presets; turn lighting on to show them on your SC3." Style="{StaticResource CaptionText}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                    <Button Grid.Column="2" Style="{StaticResource PremiumButton}" Content="Turn on" Margin="16,0,0,0" Click="TurnLightingOnButton_Click" />
                                </Grid>
                            </Border>

                            <!-- Color -->
                            <Border Style="{StaticResource CardStyle}" Padding="20">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" MinWidth="240" />
                                    </Grid.ColumnDefinitions>
                                    <controls:HsvColorPicker x:Name="ColorPicker" Width="276" Height="276" VerticalAlignment="Top"
                                                             SelectedColorChanged="ColorPicker_SelectedColorChanged" />

                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Color" Style="{StaticResource SectionTitleText}" />
                                        <Grid Margin="0,14,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="14" /><ColumnDefinition Width="96" /></Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock x:Name="HexLabel" Text="Hex" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                                                <TextBox x:Name="HexBox" Text="#FF7800" MaxLength="7" AutomationProperties.LabeledBy="{Binding ElementName=HexLabel}"
                                                         AutomationProperties.HelpText="Six-digit color code, for example #FF7800."
                                                         TextChanged="HexBox_TextChanged" LostKeyboardFocus="HexBox_LostKeyboardFocus" PreviewKeyDown="InputBox_PreviewKeyDown" />
                                            </StackPanel>
                                            <Border x:Name="ColorPreview" Grid.Column="2" CornerRadius="10" Background="#FF7800" Height="62" VerticalAlignment="Bottom"
                                                    BorderBrush="{StaticResource ControlStrokeBrush}" BorderThickness="1" AutomationProperties.Name="Current color preview">
                                                <Border.Effect><DropShadowEffect x:Name="PreviewGlow" Color="#FF7800" BlurRadius="16" ShadowDepth="0" Opacity="0.45" /></Border.Effect>
                                            </Border>
                                        </Grid>
                                        <UniformGrid Rows="1" Columns="3" Margin="0,14,0,0">
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock x:Name="RedLabel" Text="Red" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                                                <TextBox x:Name="RedBox" MaxLength="3" AutomationProperties.LabeledBy="{Binding ElementName=RedLabel}" AutomationProperties.HelpText="0 to 255"
                                                         TextChanged="RgbBox_TextChanged" LostKeyboardFocus="RgbBox_LostKeyboardFocus" PreviewKeyDown="InputBox_PreviewKeyDown" />
                                            </StackPanel>
                                            <StackPanel Margin="0,0,10,0">
                                                <TextBlock x:Name="GreenLabel" Text="Green" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                                                <TextBox x:Name="GreenBox" MaxLength="3" AutomationProperties.LabeledBy="{Binding ElementName=GreenLabel}" AutomationProperties.HelpText="0 to 255"
                                                         TextChanged="RgbBox_TextChanged" LostKeyboardFocus="RgbBox_LostKeyboardFocus" PreviewKeyDown="InputBox_PreviewKeyDown" />
                                            </StackPanel>
                                            <StackPanel>
                                                <TextBlock x:Name="BlueLabel" Text="Blue" Style="{StaticResource LabelText}" Margin="0,0,0,6" />
                                                <TextBox x:Name="BlueBox" MaxLength="3" AutomationProperties.LabeledBy="{Binding ElementName=BlueLabel}" AutomationProperties.HelpText="0 to 255"
                                                         TextChanged="RgbBox_TextChanged" LostKeyboardFocus="RgbBox_LostKeyboardFocus" PreviewKeyDown="InputBox_PreviewKeyDown" />
                                            </StackPanel>
                                        </UniformGrid>

                                        <Grid Margin="0,20,0,0">
                                            <TextBlock x:Name="BrightnessLabel" Text="Brightness" Style="{StaticResource LabelText}" />
                                            <TextBlock x:Name="BrightnessText" Text="100%" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="&#xE706;" Style="{StaticResource IconText}" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,0,10,0" />
                                            <Slider x:Name="BrightnessSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="100" Style="{StaticResource BrightnessSlider}"
                                                    AutomationProperties.LabeledBy="{Binding ElementName=BrightnessLabel}" ValueChanged="BrightnessSlider_ValueChanged" />
                                            <TextBlock Grid.Column="2" Text="&#xE706;" Style="{StaticResource IconText}" FontSize="19" Foreground="{StaticResource SecondaryTextBrush}" Margin="10,0,0,0" />
                                        </Grid>
                                        <TextBlock Text="Tip: on the color wheel, use arrow keys for shade and Page Up/Page Down for hue." Style="{StaticResource CaptionText}" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!-- Effect -->
                            <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,12,0,0">
                                <StackPanel>
                                    <TextBlock x:Name="EffectLabel" Text="Effect" Style="{StaticResource SectionTitleText}" />
                                    <UniformGrid Rows="1" Columns="5" Margin="0,12,0,0" KeyboardNavigation.DirectionalNavigation="Cycle"
                                                 AutomationProperties.LabeledBy="{Binding ElementName=EffectLabel}">
                                        <RadioButton x:Name="StaticEffectButton" GroupName="Effect" Content="Static" Tag="Static" Style="{StaticResource SegmentedRadio}" Checked="EffectButton_Click" Margin="0,0,8,0" />
                                        <RadioButton x:Name="BreathingEffectButton" GroupName="Effect" Content="Breathing" Tag="Breathing" Style="{StaticResource SegmentedRadio}" Checked="EffectButton_Click" Margin="0,0,8,0" />
                                        <RadioButton x:Name="RainbowEffectButton" GroupName="Effect" Content="Rainbow" Tag="Rainbow" Style="{StaticResource SegmentedRadio}" Checked="EffectButton_Click" Margin="0,0,8,0" />
                                        <RadioButton x:Name="PulseEffectButton" GroupName="Effect" Content="Pulse" Tag="Pulse" Style="{StaticResource SegmentedRadio}" Checked="EffectButton_Click" Margin="0,0,8,0" />
                                        <RadioButton x:Name="ColorCycleEffectButton" GroupName="Effect" Content="Color cycle" Tag="ColorCycle" Style="{StaticResource SegmentedRadio}" Checked="EffectButton_Click" />
                                    </UniformGrid>
                                    <Grid x:Name="EffectSpeedPanel" Margin="0,16,0,0" Visibility="Collapsed">
                                        <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="Auto" /></Grid.RowDefinitions>
                                        <Grid>
                                            <TextBlock x:Name="EffectSpeedLabel" Text="Speed" Style="{StaticResource LabelText}" />
                                            <TextBlock x:Name="EffectSpeedText" Text="50%" FontSize="13" FontWeight="SemiBold" HorizontalAlignment="Right" />
                                        </Grid>
                                        <Grid Grid.Row="1" Margin="0,4,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                            <TextBlock Text="Slow" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                            <Slider x:Name="EffectSpeedSlider" Grid.Column="1" Minimum="1" Maximum="100" Value="50" Style="{StaticResource BrightnessSlider}"
                                                    AutomationProperties.LabeledBy="{Binding ElementName=EffectSpeedLabel}" ValueChanged="EffectSpeedSlider_ValueChanged" />
                                            <TextBlock Grid.Column="2" Text="Fast" Style="{StaticResource CaptionText}" VerticalAlignment="Center" Margin="12,0,0,0" />
                                        </Grid>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!-- Presets -->
                            <Border Style="{StaticResource CardStyle}" Padding="20" Margin="0,12,0,0">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock x:Name="PresetsLabel" Text="Presets" Style="{StaticResource SectionTitleText}" />
                                            <TextBlock x:Name="PresetHintText" Text="Pick a preset to use it. Your changes are kept until you save." Style="{StaticResource CaptionText}" Margin="0,4,0,0"
                                                       AutomationProperties.LiveSetting="Polite" />
                                        </StackPanel>
                                        <WrapPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                            <Button x:Name="RandomColorButton" AutomationProperties.Name="Random color" Style="{StaticResource PremiumButton}" Margin="8,0,0,0" Click="RandomColorButton_Click" ToolTip="Pick a random vivid color (Ctrl+R)">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE8B1;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" /><TextBlock Text="Random" /></StackPanel>
                                            </Button>
                                            <Button x:Name="AddPresetButton" AutomationProperties.Name="Save as new preset" Style="{StaticResource PremiumButton}" Margin="8,0,0,0" Click="AddPresetButton_Click" ToolTip="Save the current color as a new preset (Ctrl+N)">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE710;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" /><TextBlock Text="Save as new" /></StackPanel>
                                            </Button>
                                            <Button x:Name="ApplyButton" AutomationProperties.Name="Save changes to preset" Style="{StaticResource AccentButton}" Margin="8,0,0,0" Click="ApplyButton_Click" Visibility="Collapsed" ToolTip="Save changes to the selected preset (Ctrl+S)">
                                                <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE74E;" Style="{StaticResource IconText}" FontSize="14" Margin="0,0,8,0" Foreground="{DynamicResource AccentForegroundBrush}" /><TextBlock x:Name="ApplyButtonText" Text="Save changes" Foreground="{DynamicResource AccentForegroundBrush}" /></StackPanel>
                                            </Button>
                                        </WrapPanel>
                                    </Grid>

                                    <ItemsControl x:Name="PresetItemsControl" Margin="0,14,0,0" Focusable="False" AutomationProperties.LabeledBy="{Binding ElementName=PresetsLabel}"
                                                  KeyboardNavigation.DirectionalNavigation="Contained" KeyboardNavigation.TabNavigation="Once">
                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,10,10">
                                                    <RadioButton GroupName="Presets" Style="{StaticResource PresetTile}" Tag="{Binding}" IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                                 Checked="PresetCard_Click" Click="PresetTile_Click" PreviewKeyDown="PresetTile_PreviewKeyDown"
                                                                 AutomationProperties.Name="{Binding AccessibleName}" AutomationProperties.HelpText="Press Delete to remove this preset." ToolTip="{Binding DisplayName}">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                            <Ellipse Width="24" Height="24" Fill="{Binding Hex}" Stroke="{StaticResource ControlStrokeBrush}" StrokeThickness="1" />
                                                            <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding DisplayName}" FontSize="13.5" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Subtitle}" FontSize="12" Foreground="{StaticResource SecondaryTextBrush}" Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </RadioButton>
                                                    <Button Tag="{Binding}" Content="&#xE711;" Style="{StaticResource PresetDeleteButton}" Click="DeletePresetButton_Click"
                                                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,4,0" IsTabStop="False"
                                                            AutomationProperties.Name="{Binding DeleteName}" ToolTip="Delete preset (Delete key)" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <!-- Selected preset editor -->
                                    <Grid x:Name="PresetEditorPanel" Margin="0,4,0,0" Visibility="Collapsed">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="280" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="PresetNameLabel" Text="Preset name" Style="{StaticResource LabelText}" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <TextBox x:Name="PresetNameBox" Grid.Column="1" MaxLength="40" AutomationProperties.LabeledBy="{Binding ElementName=PresetNameLabel}"
                                                 ToolTip="Rename the selected preset (F2)" TextChanged="PresetNameBox_TextChanged" PreviewKeyDown="InputBox_PreviewKeyDown" />
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <ui:SettingsView x:Name="IntegratedSettingsView" Visibility="Collapsed" AutomationProperties.Name="Settings page"
                                     RestoreRequested="IntegratedSettingsView_RestoreRequested"
                                     BackRequested="IntegratedSettingsView_BackRequested"
                                     CheckForUpdatesRequested="IntegratedSettingsView_CheckForUpdatesRequested"
                                     UpdateNowRequested="IntegratedSettingsView_UpdateNowRequested"
                                     CancelDownloadRequested="IntegratedSettingsView_CancelDownloadRequested"
                                     InstallAndRestartRequested="IntegratedSettingsView_InstallAndRestartRequested"
                                     AutomaticUpdateCheckChanged="IntegratedSettingsView_AutomaticUpdateCheckChanged"
                                     StartWithWindowsChanged="IntegratedSettingsView_StartWithWindowsChanged" />
                </Grid>
            </Grid>

            <!-- Status bar -->
            <Border Grid.Row="2" Background="{StaticResource PanelBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="16,0" MinHeight="44">
                <Grid>
                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="FooterConnectionText" Text="Looking for FIFINE SC3" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                        <TextBlock Text="·" Foreground="{StaticResource MutedBrush}" Margin="10,0" />
                        <TextBlock x:Name="FooterReadyText" Text="Checking" FontSize="13" Foreground="{StaticResource SecondaryTextBrush}" />
                    </StackPanel>
                    <StackPanel x:Name="FooterStatusPanel" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                        <TextBlock x:Name="TransferStatusText" Text="" FontSize="13" Foreground="{StaticResource TextBrush}" TextTrimming="CharacterEllipsis" MaxWidth="420" VerticalAlignment="Center"
                                  
                                   AutomationProperties.LiveSetting="Polite" />
                        <Button x:Name="UndoDeleteButton" Style="{StaticResource SubtleButton}" Content="Undo" Margin="8,0,0,0" Padding="8,2" MinHeight="28" Visibility="Collapsed"
                                Foreground="{DynamicResource AccentTextBrush}" Click="UndoDeleteButton_Click" ToolTip="Restore the deleted preset (Ctrl+Z)" />
                    </StackPanel>
                    <Border x:Name="UpdateBanner" Grid.Column="2" Visibility="Collapsed" HorizontalAlignment="Right" Background="{StaticResource SuccessBarBackgroundBrush}" BorderBrush="{StaticResource ConnectedBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,4" Margin="12,6">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="UpdateBannerText" Text="Update available" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            <Button Content="Update now" MinHeight="28" Padding="10,2" Margin="12,0,6,0" FontSize="12.5" Style="{StaticResource PremiumButton}" Click="UpdateBannerButton_Click" />
                            <Button Content="Later" MinHeight="28" Padding="10,2" FontSize="12.5" Style="{StaticResource SubtleButton}" Click="UpdateBannerLaterButton_Click" />
                        </StackPanel>
                    </Border>
                    <Button x:Name="FooterReconnectButton" AutomationProperties.Name="Reconnect to SC3" Grid.Column="3" Style="{StaticResource SubtleButton}" Click="ReconnectButton_Click" VerticalAlignment="Center"
                            ToolTip="Reconnect to the SC3 if lighting stops responding">
                        <StackPanel Orientation="Horizontal"><TextBlock Text="&#xE72C;" Style="{StaticResource IconText}" FontSize="13" Margin="0,0,8,0" /><TextBlock Text="Reconnect" FontSize="13" /></StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
