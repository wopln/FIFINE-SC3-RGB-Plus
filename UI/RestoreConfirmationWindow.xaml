<Window x:Class="SC3RGBController.UI.RestoreConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore Original Firmware?" Width="520" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FocusManager.FocusedElement="{Binding ElementName=CancelButton}">
    <!-- Destructive confirmation: Cancel is the default (Enter) and initially focused button,
         so a stray Enter can never start a firmware flash. Escape also cancels. -->
    <StackPanel Margin="28,24,28,24">
        <TextBlock Text="Restore original firmware?" Style="{StaticResource PageTitleText}" FontSize="20" TextWrapping="Wrap"/>

        <TextBlock Style="{StaticResource CaptionText}" FontSize="14" Margin="0,14,0,0"
                   Text="This removes SC3 RGB+ firmware and restores the original FIFINE SC3 firmware. RGB+ lighting and Custom button shortcuts will stop working."/>
        <TextBlock Style="{StaticResource CaptionText}" FontSize="14" Margin="0,10,0,0"
                   Text="Your mixer will restart during the process."/>

        <Border Style="{StaticResource InfoBarStyle}" Background="{StaticResource WarningBarBackgroundBrush}"
                BorderBrush="{StaticResource WarningBrush}" Margin="0,16,0,0">
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <TextBlock Style="{StaticResource IconText}" Text="&#xE7BA;" Foreground="{StaticResource WarningBrush}"
                           VerticalAlignment="Top" Margin="0,1,10,0"/>
                <TextBlock Grid.Column="1" Text="Do not disconnect the SC3 until restoration is complete." TextWrapping="Wrap"/>
            </Grid>
        </Border>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="CancelButton" Content="Cancel" MinWidth="110" Margin="0,0,10,0"
                    Style="{StaticResource PremiumButton}" IsDefault="True" IsCancel="True"
                    Click="CancelButton_Click"/>
            <Button x:Name="RestoreButton" Content="Restore Firmware" MinWidth="150"
                    Style="{StaticResource PremiumButton}" BorderBrush="{StaticResource DisconnectedBrush}"
                    AutomationProperties.Name="Restore original firmware"
                    AutomationProperties.HelpText="Removes RGB+ firmware and restores the original FIFINE SC3 firmware."
                    Click="RestoreButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
