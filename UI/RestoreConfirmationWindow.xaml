<Window x:Class="SC3RGBController.UI.RestoreConfirmationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Restore Original Firmware?" Width="520" Height="310" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#090909" Foreground="White">
    <Border BorderBrush="#343434" BorderThickness="1" CornerRadius="14" Padding="28" Background="#0D0D0D">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="18"/><RowDefinition Height="*"/><RowDefinition Height="24"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="Restore Original Firmware?" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="2" Foreground="#C3C3C3" FontSize="13" TextWrapping="Wrap" LineHeight="21">
                <Run Text="This will remove SC3 RGB+ firmware and restore the original FIFINE SC3 firmware."/><LineBreak/><LineBreak/>
                <Run Text="Your mixer will restart during the process."/><LineBreak/><LineBreak/>
                <Run Text="Do not disconnect the SC3 until restoration is complete."/>
            </TextBlock>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Width="110" Height="38" Margin="0,0,12,0" Background="#1A1A1A" Foreground="White" BorderBrush="#555555" BorderThickness="1" Click="CancelButton_Click"/>
                <Button Content="Restore Firmware" Width="155" Height="38" Background="#FF7800" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="RestoreButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
