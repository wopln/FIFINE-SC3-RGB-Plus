<Window x:Class="SC3RGBController.UI.RecoveryModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SC3 Recovery Mode" Width="500" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        FocusManager.FocusedElement="{Binding ElementName=CloseButton}">
    <!-- Choosing Restore here only opens the Restore confirmation dialog (nothing is flashed yet).
         Close stays the default/initially focused action so Enter never starts a firmware operation. -->
    <StackPanel Margin="28,24,28,24">
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource IconText}" Text="&#xE7BA;" FontSize="20" Foreground="{StaticResource WarningBrush}"
                       VerticalAlignment="Top" Margin="0,4,10,0"/>
            <TextBlock Grid.Column="1" Text="SC3 detected in recovery mode" Style="{StaticResource PageTitleText}" FontSize="20" TextWrapping="Wrap"/>
        </Grid>

        <TextBlock Style="{StaticResource CaptionText}" FontSize="14" Margin="0,14,0,0"
                   Text="A firmware update may not have completed."/>
        <TextBlock Style="{StaticResource CaptionText}" FontSize="14" Margin="0,10,0,0"
                   Text="You can safely restore the original FIFINE SC3 firmware using the validated recovery path. You will be asked to confirm before anything is written."/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,24,0,0">
            <Button x:Name="CloseButton" Content="Close" MinWidth="100" Margin="0,0,10,0"
                    Style="{StaticResource PremiumButton}" IsDefault="True" IsCancel="True"
                    Click="CloseButton_Click"/>
            <Button x:Name="RestoreButton" Content="Restore Original Firmware…" MinWidth="200"
                    Style="{StaticResource PremiumButton}" BorderBrush="{StaticResource DisconnectedBrush}"
                    AutomationProperties.Name="Restore original firmware"
                    AutomationProperties.HelpText="Opens a confirmation before restoring the original FIFINE SC3 firmware."
                    Click="RestoreButton_Click"/>
        </StackPanel>
    </StackPanel>
</Window>
