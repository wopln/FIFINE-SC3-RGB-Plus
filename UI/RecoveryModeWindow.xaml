<Window x:Class="SC3RGBController.UI.RecoveryModeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SC3 Recovery Mode" Width="500" Height="270" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" Background="#090909" Foreground="White">
    <Border BorderBrush="#343434" BorderThickness="1" CornerRadius="14" Padding="28" Background="#0D0D0D">
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="16"/><RowDefinition Height="*"/><RowDefinition Height="22"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <TextBlock Text="SC3 detected in recovery mode" FontSize="22" FontWeight="SemiBold"/>
            <TextBlock Grid.Row="2" Text="A firmware update may not have completed.&#10;&#10;You can safely restore the original FIFINE SC3 firmware using the validated recovery path."
                       Foreground="#B8B8B8" FontSize="13" TextWrapping="Wrap" LineHeight="21"/>
            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Close" Width="100" Height="38" Margin="0,0,12,0" Background="#1A1A1A" Foreground="White" BorderBrush="#555555" BorderThickness="1" Click="CloseButton_Click"/>
                <Button Content="Restore Original Firmware" Width="195" Height="38" Background="#FF7800" Foreground="White" BorderThickness="0" FontWeight="SemiBold" Click="RestoreButton_Click"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
