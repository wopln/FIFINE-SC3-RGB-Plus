<UserControl x:Class="SC3RGBController.UI.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="White">
    <UserControl.Resources>
        <Style x:Key="SettingsBackButton" TargetType="Button" BasedOn="{StaticResource PremiumButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinWidth" Value="88"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="BorderBrush" Value="#3A3A3A"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
        <Style x:Key="SettingsNavigationButton" TargetType="Button">
            <Setter Property="Height" Value="46"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Background" Value="#111111"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#343434"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                            <ContentPresenter Margin="14,0,12,0" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background" Value="#19221C"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.78"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="UpdateActionButton" TargetType="Button" BasedOn="{StaticResource PremiumButton}">
            <Setter Property="Height" Value="36"/>
            <Setter Property="MinHeight" Value="36"/>
            <Setter Property="Padding" Value="14,6"/>
            <Setter Property="FontSize" Value="12.5"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        </Style>
    </UserControl.Resources>


    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Margin="4,0,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Settings" FontSize="24" FontWeight="SemiBold"/>
                <TextBlock Text="Choose a settings category." Foreground="{StaticResource MutedBrush}" FontSize="11.5" Margin="0,7,0,0"/>
            </StackPanel>
            <Button Grid.Column="1" Style="{StaticResource SettingsBackButton}" Content="←  Back"
                    VerticalAlignment="Top" Click="BackButton_Click"/>
        </Grid>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="190"/>
                <ColumnDefinition Width="24"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Margin="4,0,0,0">
                <Button x:Name="CustomButtonsNavigationButton" Style="{StaticResource SettingsNavigationButton}"
                        Content="Custom Buttons" Margin="0,0,0,10" Click="CustomButtonsNavigationButton_Click"/>
                <Button x:Name="UpdatesNavigationButton" Style="{StaticResource SettingsNavigationButton}"
                        Content="Updates" Margin="0,0,0,10" Click="UpdatesNavigationButton_Click"/>
                <Button x:Name="TroubleshootingNavigationButton" Style="{StaticResource SettingsNavigationButton}"
                        Content="Troubleshooting" Click="TroubleshootingNavigationButton_Click"/>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}" Padding="28">
                <Grid>
                <Grid x:Name="CustomButtonsContent" Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Text="Custom Buttons" FontSize="24" FontWeight="SemiBold"/>
                        <TextBlock Text="Use the SC3 Custom A–D buttons to launch applications." Foreground="{StaticResource SecondaryTextBrush}" FontSize="12.5" Margin="0,7,0,22"/>
                        <Border Background="{StaticResource PanelAltBrush}" BorderBrush="#343434" BorderThickness="1" CornerRadius="12" Padding="20" Margin="0,0,0,16">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Custom Button Shortcuts" FontSize="16" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CustomShortcutStatusText" Text="Original SC3 button behavior is active." Foreground="{StaticResource SecondaryTextBrush}" FontSize="11.5" Margin="0,6,0,0" TextWrapping="Wrap"/>
                                    <TextBlock x:Name="CustomBackgroundNoteText" Text="Custom button shortcuts will remain active in the background when this window is closed." Foreground="{StaticResource MutedBrush}" FontSize="10.5" Margin="0,6,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="20,0,0,0">
                                    <TextBlock Text="Enable Custom Button Shortcuts" VerticalAlignment="Center" FontSize="12.5" Margin="0,0,12,0"/>
                                    <CheckBox x:Name="CustomShortcutsToggle" Style="{StaticResource ToggleSwitch}" Width="48" Height="25" Checked="CustomShortcutsToggle_Changed" Unchecked="CustomShortcutsToggle_Changed"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <Border x:Name="CustomFirmwareRequirementPanel" Background="#15120D" BorderBrush="#6A4B22" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,0,0,16" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Firmware 1.5 is required" FontSize="14" FontWeight="SemiBold"/>
                                    <TextBlock x:Name="CustomFirmwareRequirementText" Text="Firmware 1.5 is required for Custom Button Shortcuts." Foreground="{StaticResource SecondaryTextBrush}" FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Button Grid.Column="1" Content="Update Firmware" MinWidth="140" Margin="20,0,0,0" VerticalAlignment="Center"
                                        Style="{StaticResource UpdateActionButton}" BorderBrush="#FF7800" Click="CustomFirmwareUpdateButton_Click"/>
                            </Grid>
                        </Border>                        <Border Background="{StaticResource PanelAltBrush}" BorderBrush="#343434" BorderThickness="1" CornerRadius="12" Padding="18">
                            <StackPanel>
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="Custom A" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="CustomANameText" Grid.Column="1" Text="Not assigned" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Tag="A" Content="Choose App" Style="{StaticResource UpdateActionButton}" Click="ChooseCustomApp_Click"/><Button Tag="A" Content="Clear" Margin="8,0,0,0" Style="{StaticResource UpdateActionButton}" Click="ClearCustomApp_Click"/></StackPanel></Grid>
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="Custom B" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="CustomBNameText" Grid.Column="1" Text="Not assigned" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Tag="B" Content="Choose App" Style="{StaticResource UpdateActionButton}" Click="ChooseCustomApp_Click"/><Button Tag="B" Content="Clear" Margin="8,0,0,0" Style="{StaticResource UpdateActionButton}" Click="ClearCustomApp_Click"/></StackPanel></Grid>
                                <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="Custom C" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="CustomCNameText" Grid.Column="1" Text="Not assigned" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Tag="C" Content="Choose App" Style="{StaticResource UpdateActionButton}" Click="ChooseCustomApp_Click"/><Button Tag="C" Content="Clear" Margin="8,0,0,0" Style="{StaticResource UpdateActionButton}" Click="ClearCustomApp_Click"/></StackPanel></Grid>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="90"/><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions><TextBlock Text="Custom D" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="CustomDNameText" Grid.Column="1" Text="Not assigned" Foreground="{StaticResource SecondaryTextBrush}" VerticalAlignment="Center"/><StackPanel Grid.Column="2" Orientation="Horizontal"><Button Tag="D" Content="Choose App" Style="{StaticResource UpdateActionButton}" Click="ChooseCustomApp_Click"/><Button Tag="D" Content="Clear" Margin="8,0,0,0" Style="{StaticResource UpdateActionButton}" Click="ClearCustomApp_Click"/></StackPanel></Grid>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </Grid>
                <Grid x:Name="UpdatesContent" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="7"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="20"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="18"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="8"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="16"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>

                    <TextBlock Text="Updates" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="2" Text="Keep the application and your SC3 firmware up to date."
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="12.5"/>

                    <TextBlock Grid.Row="4" Text="APPLICATION" Foreground="{StaticResource MutedBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                    <Border Grid.Row="6" Background="{StaticResource PanelAltBrush}" BorderBrush="#343434"
                            BorderThickness="1" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="13"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="18"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Current version" Foreground="{StaticResource MutedBrush}" FontSize="11.5"/>
                                    <TextBlock x:Name="CurrentVersionText" Text="v0.0.0" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Latest" Foreground="{StaticResource MutedBrush}" FontSize="11.5"/>
                                    <TextBlock x:Name="LatestVersionText" Text="Not checked" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock Text="Status" Foreground="{StaticResource MutedBrush}" FontSize="11.5" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="UpdateStatusText" Text="Not checked yet" FontSize="13" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>

                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="Automatically check for updates" FontSize="13.5" FontWeight="SemiBold"/>
                                    <TextBlock Text="Checks once after startup. No automatic installation." Foreground="{StaticResource MutedBrush}" FontSize="10.8" Margin="0,4,0,0"/>
                                </StackPanel>
                                <CheckBox x:Name="AutomaticUpdateCheckToggle" Grid.Column="1" Style="{StaticResource ToggleSwitch}" Width="48" Height="25"
                                          VerticalAlignment="Center" Checked="AutomaticUpdateCheckToggle_Changed" Unchecked="AutomaticUpdateCheckToggle_Changed"/>
                            </Grid>

                            <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                <Button x:Name="CheckForUpdatesButton" Content="Check for Updates" MinWidth="145" Margin="0,0,10,0"
                                        Style="{StaticResource UpdateActionButton}" Click="CheckForUpdatesButton_Click"/>
                                <Button x:Name="UpdateNowButton" Content="Update Now" MinWidth="120" Visibility="Collapsed"
                                        Style="{StaticResource UpdateActionButton}" Background="#151B17" BorderBrush="{StaticResource ConnectedBrush}"
                                        Click="UpdateNowButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <TextBlock Grid.Row="8" Text="MIXER FIRMWARE" Foreground="{StaticResource MutedBrush}" FontSize="10.5" FontWeight="SemiBold"/>
                    <Border Grid.Row="10" Background="{StaticResource PanelAltBrush}" BorderBrush="#343434" BorderThickness="1" CornerRadius="12" Padding="20">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="Current" Foreground="{StaticResource MutedBrush}" FontSize="11.5"/>
                                    <TextBlock x:Name="MixerFirmwareCurrentText" Text="Not detected" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Latest" Foreground="{StaticResource MutedBrush}" FontSize="11.5"/>
                                    <TextBlock x:Name="MixerFirmwareLatestText" Text="RGB+ Firmware 1.5" FontSize="15" FontWeight="SemiBold" Margin="0,4,0,0"/>
                                </StackPanel>
                                <StackPanel Grid.Column="2" HorizontalAlignment="Right">
                                    <TextBlock Text="Status" Foreground="{StaticResource MutedBrush}" FontSize="11.5" HorizontalAlignment="Right"/>
                                    <TextBlock x:Name="MixerFirmwareStatusText" Text="Connect your SC3" FontSize="13" Margin="0,4,0,0" HorizontalAlignment="Right"/>
                                </StackPanel>
                            </Grid>
                            <Grid Grid.Row="2">
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBlock x:Name="MixerFirmwareDescriptionText" Text="Connect a supported FIFINE SC3 to check mixer firmware."
                                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="11.5" TextWrapping="Wrap" VerticalAlignment="Center" MaxWidth="430"/>
                                <StackPanel x:Name="MixerFirmwareActionPanel" Grid.Column="1" Orientation="Horizontal" Margin="18,0,0,0" Visibility="Collapsed">
                                    <Button x:Name="FirmwareLaterButton" Content="Later" MinWidth="82" Margin="0,0,10,0" Style="{StaticResource UpdateActionButton}" Click="FirmwareLaterButton_Click"/>
                                    <Button x:Name="UpdateFirmwareButton" Content="Update Firmware" MinWidth="145" Style="{StaticResource UpdateActionButton}"
                                            Background="#151B17" BorderBrush="{StaticResource ConnectedBrush}" Click="UpdateFirmwareButton_Click"/>
                                </StackPanel>
                            </Grid>
                        </Grid>
                    </Border>

                    <Border x:Name="DownloadPanel" Grid.Row="12" Background="#101510" BorderBrush="#2E5735" BorderThickness="1" CornerRadius="12" Padding="18" Visibility="Collapsed">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="12"/><RowDefinition Height="8"/><RowDefinition Height="16"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                            <Grid>
                                <TextBlock x:Name="DownloadStatusText" Text="Downloading update..." FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock x:Name="DownloadPercentText" Text="0%" Foreground="{StaticResource ConnectedBrush}" HorizontalAlignment="Right" FontSize="12"/>
                            </Grid>
                            <ProgressBar x:Name="UpdateDownloadProgress" Grid.Row="2" Minimum="0" Maximum="100" Value="0" Height="8"
                                         Background="#252525" Foreground="{StaticResource ConnectedBrush}" BorderThickness="0"/>
                            <Button Grid.Row="4" Content="Cancel" Width="96" HorizontalAlignment="Right" Style="{StaticResource UpdateActionButton}" Click="CancelDownloadButton_Click"/>
                        </Grid>
                    </Border>

                    <Border x:Name="UpdateReadyPanel" Grid.Row="14" Background="#101510" BorderBrush="{StaticResource ConnectedBrush}" BorderThickness="1" CornerRadius="12" Padding="18" Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Update ready to install" FontSize="14" FontWeight="SemiBold"/>
                                <TextBlock x:Name="UpdateReadyDetailText" Text="The verified update is ready." Foreground="{StaticResource SecondaryTextBrush}" FontSize="11.5" Margin="0,5,0,0" TextWrapping="Wrap"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button Content="Later" MinWidth="88" Margin="0,0,10,0" Style="{StaticResource UpdateActionButton}" Click="ReadyLaterButton_Click"/>
                                <Button Content="Install and Restart" MinWidth="170" Style="{StaticResource UpdateActionButton}"
                                        Background="#151B17" BorderBrush="{StaticResource ConnectedBrush}" Click="InstallAndRestartButton_Click"/>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <Grid x:Name="TroubleshootingContent">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="7"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="24"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <TextBlock Text="Troubleshooting" FontSize="24" FontWeight="SemiBold"/>
                    <TextBlock Grid.Row="2" Text="Repair and recovery options for your FIFINE SC3."
                               Foreground="{StaticResource SecondaryTextBrush}" FontSize="12.5"/>
                    <Border Grid.Row="4" Background="{StaticResource PanelAltBrush}" BorderBrush="#343434"
                            BorderThickness="1" CornerRadius="12" Padding="22">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="20"/>
                                <ColumnDefinition Width="230"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Restore Original Firmware" FontSize="16" FontWeight="SemiBold"/>
                                <TextBlock Text="Restore the FIFINE SC3 to the original factory firmware and remove RGB+ support."
                                           Foreground="{StaticResource SecondaryTextBrush}" FontSize="12" Margin="0,7,0,0"
                                           TextWrapping="Wrap" MaxWidth="430"/>
                            </StackPanel>
                            <Button Grid.Column="2" Content="Restore Original Firmware" Width="230" Height="38" Padding="18,8"
                                    Style="{StaticResource PremiumButton}" Background="#1B1B1B"
                                    BorderBrush="#FF7800" BorderThickness="1.5" FocusVisualStyle="{x:Null}"
                                    Click="RestoreButton_Click"/>
                        </Grid>
                    </Border>
                </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
