<UserControl x:Class="SC3RGBController.UI.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent" Foreground="{StaticResource TextBrush}"
             PreviewKeyDown="SettingsView_PreviewKeyDown">
    <UserControl.Resources>
        <!-- Inner group card inside the section card. -->
        <Style x:Key="SettingsGroupBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource PanelAltBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="20"/>
        </Style>
        <!-- Section title (second level under the "Settings" page title). -->
        <Style x:Key="SettingsSectionHeading" TargetType="TextBlock" BasedOn="{StaticResource PageTitleText}">
            <Setter Property="FontSize" Value="20"/>
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level2"/>
        </Style>
        <!-- Group title inside a section (third level). -->
        <Style x:Key="SettingsGroupHeading" TargetType="TextBlock" BasedOn="{StaticResource SectionTitleText}">
            <Setter Property="AutomationProperties.HeadingLevel" Value="Level3"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
        </Style>
        <!-- Small field label above a value (e.g. "Current version"). -->
        <Style x:Key="FieldLabelText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
        </Style>
        <!-- Field value under a label. -->
        <Style x:Key="FieldValueText" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="FontSize" Value="15"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Margin" Value="0,4,12,0"/>
        </Style>
        <Style x:Key="SettingsProgressBar" TargetType="ProgressBar">
            <Setter Property="Height" Value="8"/>
            <Setter Property="Minimum" Value="0"/>
            <Setter Property="Maximum" Value="100"/>
            <Setter Property="Background" Value="{StaticResource PressedBrush}"/>
            <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}"/>
            <Setter Property="BorderBrush" Value="{StaticResource ControlStrokeBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="18"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" Text="Settings" Style="{StaticResource PageTitleText}" Margin="4,0,0,0"/>

        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="176"/>
                <ColumnDefinition Width="20"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Section navigation: one radio group. Tab enters once; Up/Down move and select. -->
            <StackPanel x:Name="SettingsNavigationPanel" Grid.Column="0" Margin="4,0,0,0"
                        AutomationProperties.Name="Settings sections"
                        KeyboardNavigation.DirectionalNavigation="Cycle"
                        KeyboardNavigation.TabNavigation="Once"
                        PreviewKeyDown="SettingsNavigationPanel_PreviewKeyDown">
                <RadioButton x:Name="GeneralNavigationButton" Style="{StaticResource NavItem}" GroupName="SettingsNav"
                             AutomationProperties.Name="General" Margin="0,0,0,4" Checked="GeneralNavigationButton_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE713;" Margin="0,0,12,0"/>
                        <TextBlock Text="General" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="CustomButtonsNavigationButton" Style="{StaticResource NavItem}" GroupName="SettingsNav"
                             AutomationProperties.Name="Custom buttons" Margin="0,0,0,4" Checked="CustomButtonsNavigationButton_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE765;" Margin="0,0,12,0"/>
                        <TextBlock Text="Custom buttons" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="UpdatesNavigationButton" Style="{StaticResource NavItem}" GroupName="SettingsNav"
                             AutomationProperties.Name="Updates" Margin="0,0,0,4" Checked="UpdatesNavigationButton_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE895;" Margin="0,0,12,0"/>
                        <TextBlock Text="Updates" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
                <RadioButton x:Name="TroubleshootingNavigationButton" Style="{StaticResource NavItem}" GroupName="SettingsNav"
                             AutomationProperties.Name="Troubleshooting" Checked="TroubleshootingNavigationButton_Checked">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource IconText}" Text="&#xE90F;" Margin="0,0,12,0"/>
                        <TextBlock Text="Troubleshooting" VerticalAlignment="Center"/>
                    </StackPanel>
                </RadioButton>
            </StackPanel>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <ScrollViewer x:Name="SectionScrollViewer" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Focusable="False" Padding="24">
                    <Grid>
                        <!-- ===================== General ===================== -->
                        <StackPanel x:Name="GeneralContent" Visibility="Collapsed">
                            <TextBlock Text="General" Style="{StaticResource SettingsSectionHeading}"/>
                            <TextBlock Text="Startup and background behavior." Style="{StaticResource CaptionText}" Margin="0,6,0,20"/>
                            <Border Style="{StaticResource SettingsGroupBorder}">
                                <StackPanel>
                                    <CheckBox x:Name="StartWithWindowsToggle" Style="{StaticResource ToggleSwitch}"
                                              Content="Start with Windows"
                                              AutomationProperties.HelpText="Starts in the background and restores your lighting when you sign in."
                                              Checked="StartWithWindowsToggle_Changed" Unchecked="StartWithWindowsToggle_Changed"/>
                                    <TextBlock Text="Starts in the background and restores your lighting when you sign in."
                                               Style="{StaticResource CaptionText}" Margin="0,6,0,0"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===================== Custom buttons ===================== -->
                        <StackPanel x:Name="CustomButtonsContent" Visibility="Collapsed">
                            <TextBlock Text="Custom buttons" Style="{StaticResource SettingsSectionHeading}"/>
                            <TextBlock Text="Make the SC3 Custom A–D buttons open an app, mute an app or your microphone, change volume, or control media." Style="{StaticResource CaptionText}" Margin="0,6,0,20"/>

                            <Border Style="{StaticResource SettingsGroupBorder}" Margin="0,0,0,16">
                                <StackPanel>
                                    <CheckBox x:Name="CustomShortcutsToggle" Style="{StaticResource ToggleSwitch}"
                                              Content="Custom button shortcuts"
                                              AutomationProperties.HelpText="Replaces the original SC3 Custom button behavior with the applications assigned below."
                                              Checked="CustomShortcutsToggle_Changed" Unchecked="CustomShortcutsToggle_Changed"/>
                                    <TextBlock x:Name="CustomShortcutStatusText" Text="Original SC3 button behavior is active."
                                               Style="{StaticResource CaptionText}" Margin="0,8,0,0"
                                               AutomationProperties.LiveSetting="Polite"/>
                                    <TextBlock x:Name="CustomBackgroundNoteText" Text="Custom button shortcuts will remain active in the background when this window is closed."
                                               Style="{StaticResource CaptionText}" Foreground="{StaticResource MutedBrush}" Margin="0,6,0,0" Visibility="Collapsed"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="CustomFirmwareRequirementPanel" Style="{StaticResource InfoBarStyle}"
                                    Background="{StaticResource WarningBarBackgroundBrush}" BorderBrush="{StaticResource WarningBrush}"
                                    Padding="16" Margin="0,0,0,16" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE7BA;" Foreground="{StaticResource WarningBrush}"
                                               VerticalAlignment="Top" Margin="0,2,12,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Firmware 1.5 is required" Style="{StaticResource SettingsGroupHeading}" FontSize="14"/>
                                        <TextBlock x:Name="CustomFirmwareRequirementText" Text="Firmware 1.5 is required for Custom Button Shortcuts."
                                                   Style="{StaticResource CaptionText}" Margin="0,4,0,12"/>
                                        <Button x:Name="CustomFirmwareUpdateButton" Content="Update Firmware" HorizontalAlignment="Left"
                                                Style="{StaticResource PrimaryButton}" Click="CustomFirmwareUpdateButton_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource SettingsGroupBorder}" Padding="18">
                                <StackPanel>
                                    <TextBlock Text="Assignments" Style="{StaticResource SettingsGroupHeading}" Margin="0,0,0,12"/>

                                    <!-- Custom A -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="84"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CustomALabel" Text="Custom A" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock x:Name="CustomANameText" Grid.Column="1" Text="Not assigned" Foreground="{StaticResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                                                   AutomationProperties.Name="Custom A: Not assigned"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Tag="A" Content="Choose action…" Style="{StaticResource PremiumButton}"
                                                    AutomationProperties.Name="Choose action for Custom A"
                                                    AutomationProperties.HelpText="{Binding Text, ElementName=CustomANameText}"
                                                    Click="ChooseCustomApp_Click"/>
                                            <Button Tag="A" Content="Clear" Margin="8,0,0,0" Style="{StaticResource PremiumButton}"
                                                    AutomationProperties.Name="Clear Custom A" Click="ClearCustomApp_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Custom B -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="84"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CustomBLabel" Text="Custom B" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock x:Name="CustomBNameText" Grid.Column="1" Text="Not assigned" Foreground="{StaticResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                                                   AutomationProperties.Name="Custom B: Not assigned"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Tag="B" Content="Choose action…" Style="{StaticResource PremiumButton}"
                                                    AutomationProperties.Name="Choose action for Custom B"
                                                    AutomationProperties.HelpText="{Binding Text, ElementName=CustomBNameText}"
                                                    Click="ChooseCustomApp_Click"/>
                                            <Button Tag="B" Content="Clear" Margin="8,0,0,0" Style="{StaticResource PremiumButton}"
                                                    AutomationProperties.Name="Clear Custom B" Click="ClearCustomApp_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Custom C -->
                                    <Grid Margin="0,0,0,12">
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="84"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CustomCLabel" Text="Custom C" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock x:Name="CustomCNameText" Grid.Column="1" Text="Not assigned" Foreground="{StaticResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                                                   AutomationProperties.Name="Custom C: Not assigned"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Tag="C" Content="Choose action…" Style="{StaticResource PremiumButton}"
                                                    AutomationProperties.Name="Choose action for Custom C"
                                                    AutomationProperties.HelpText="{Binding Text, ElementName=CustomCNameText}"
                                                    Click="ChooseCustomApp_Click"/>
                                            <Button Tag="C" Content="Clear" Margin="8,0,0,0" Style="{StaticResource PremiumButton}"
                                                    AutomationProperties.Name="Clear Custom C" Click="ClearCustomApp_Click"/>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Custom D -->
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto" MinWidth="84"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="CustomDLabel" Text="Custom D" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0"/>
                                        <TextBlock x:Name="CustomDNameText" Grid.Column="1" Text="Not assigned" Foreground="{StaticResource SecondaryTextBrush}"
                                                   VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,12,0"
                                                   AutomationProperties.Name="Custom D: Not assigned"/>
                                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                            <Button Tag="D" Content="Choose action…" Style="{StaticResource PremiumButton}"
                                                    AutomationProperties.Name="Choose action for Custom D"
                                                    AutomationProperties.HelpText="{Binding Text, ElementName=CustomDNameText}"
                                                    Click="ChooseCustomApp_Click"/>
                                            <Button Tag="D" Content="Clear" Margin="8,0,0,0" Style="{StaticResource PremiumButton}"
                                                    AutomationProperties.Name="Clear Custom D" Click="ClearCustomApp_Click"/>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===================== Updates ===================== -->
                        <StackPanel x:Name="UpdatesContent" Visibility="Collapsed">
                            <TextBlock Text="Updates" Style="{StaticResource SettingsSectionHeading}"/>
                            <TextBlock Text="Keep the application and your SC3 firmware up to date." Style="{StaticResource CaptionText}" Margin="0,6,0,20"/>

                            <TextBlock Text="Application" Style="{StaticResource SettingsGroupHeading}" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource SettingsGroupBorder}" Margin="0,0,0,20">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Current version" Style="{StaticResource FieldLabelText}"/>
                                            <TextBlock x:Name="CurrentVersionText" Text="v0.0.0" Style="{StaticResource FieldValueText}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Latest version" Style="{StaticResource FieldLabelText}"/>
                                            <TextBlock x:Name="LatestVersionText" Text="Not checked" Style="{StaticResource FieldValueText}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Status" Style="{StaticResource FieldLabelText}"/>
                                            <TextBlock x:Name="UpdateStatusText" Text="Not checked yet" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       AutomationProperties.LiveSetting="Polite"/>
                                        </StackPanel>
                                    </Grid>

                                    <Border Height="1" Background="{StaticResource BorderBrush}" Margin="0,16"/>

                                    <CheckBox x:Name="AutomaticUpdateCheckToggle" Style="{StaticResource ToggleSwitch}"
                                              Content="Automatically check for updates"
                                              AutomationProperties.HelpText="Checks once after startup. Updates are never installed automatically."
                                              Checked="AutomaticUpdateCheckToggle_Changed" Unchecked="AutomaticUpdateCheckToggle_Changed"/>
                                    <TextBlock Text="Checks once after startup. Updates are never installed automatically."
                                               Style="{StaticResource CaptionText}" Margin="0,6,0,16"/>

                                    <WrapPanel Orientation="Horizontal">
                                        <Button x:Name="CheckForUpdatesButton" Content="Check for Updates" Margin="0,0,10,8"
                                                Style="{StaticResource PremiumButton}" Click="CheckForUpdatesButton_Click"/>
                                        <Button x:Name="UpdateNowButton" Content="Update Now" Margin="0,0,10,8" Visibility="Collapsed"
                                                Style="{StaticResource PrimaryButton}" Click="UpdateNowButton_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>

                            <Border x:Name="DownloadPanel" Style="{StaticResource InfoBarStyle}" Padding="18" Margin="0,0,0,20" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBlock x:Name="DownloadStatusText" Text="Downloading update..." FontWeight="SemiBold" TextWrapping="Wrap"
                                                   AutomationProperties.LiveSetting="Polite"/>
                                        <TextBlock x:Name="DownloadPercentText" Grid.Column="1" Text="0%" Foreground="{StaticResource SecondaryTextBrush}"
                                                   Margin="12,0,0,0"/>
                                    </Grid>
                                    <ProgressBar x:Name="UpdateDownloadProgress" Style="{StaticResource SettingsProgressBar}" Value="0" Margin="0,12,0,16"
                                                 AutomationProperties.Name="Download progress"/>
                                    <Button x:Name="CancelDownloadButton" Content="Cancel Download" HorizontalAlignment="Left"
                                            Style="{StaticResource PremiumButton}" Click="CancelDownloadButton_Click"/>
                                </StackPanel>
                            </Border>

                            <Border x:Name="UpdateReadyPanel" Style="{StaticResource InfoBarStyle}"
                                    Background="{StaticResource SuccessBarBackgroundBrush}" BorderBrush="{StaticResource ConnectedBrush}"
                                    Padding="18" Margin="0,0,0,20" Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource IconText}" Text="&#xE930;" Foreground="{StaticResource ConnectedBrush}"
                                               VerticalAlignment="Top" Margin="0,2,12,0"/>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="Update ready to install" Style="{StaticResource SettingsGroupHeading}" FontSize="14"/>
                                        <TextBlock x:Name="UpdateReadyDetailText" Text="The verified update is ready." Style="{StaticResource CaptionText}"
                                                   Margin="0,4,0,12" AutomationProperties.LiveSetting="Polite"/>
                                        <WrapPanel Orientation="Horizontal">
                                            <Button x:Name="InstallAndRestartButton" Content="Install and Restart" Margin="0,0,10,0"
                                                    Style="{StaticResource PrimaryButton}" Click="InstallAndRestartButton_Click"/>
                                            <Button x:Name="ReadyLaterButton" Content="Later" Style="{StaticResource PremiumButton}" Click="ReadyLaterButton_Click"/>
                                        </WrapPanel>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <TextBlock Text="Mixer firmware" Style="{StaticResource SettingsGroupHeading}" Margin="0,0,0,8"/>
                            <Border Style="{StaticResource SettingsGroupBorder}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock Text="Current" Style="{StaticResource FieldLabelText}"/>
                                            <TextBlock x:Name="MixerFirmwareCurrentText" Text="Not detected" Style="{StaticResource FieldValueText}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="1">
                                            <TextBlock Text="Latest" Style="{StaticResource FieldLabelText}"/>
                                            <TextBlock x:Name="MixerFirmwareLatestText" Text="RGB+ Firmware 1.5" Style="{StaticResource FieldValueText}"/>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock Text="Status" Style="{StaticResource FieldLabelText}"/>
                                            <TextBlock x:Name="MixerFirmwareStatusText" Text="Connect your SC3" TextWrapping="Wrap" Margin="0,4,0,0"
                                                       AutomationProperties.LiveSetting="Polite"/>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="MixerFirmwareDescriptionText" Text="Connect a supported FIFINE SC3 to check mixer firmware."
                                               Style="{StaticResource CaptionText}" Margin="0,14,0,0"/>
                                    <WrapPanel x:Name="MixerFirmwareActionPanel" Orientation="Horizontal" Margin="0,14,0,0" Visibility="Collapsed">
                                        <Button x:Name="UpdateFirmwareButton" Content="Update Firmware" Margin="0,0,10,0"
                                                Style="{StaticResource PrimaryButton}" Click="UpdateFirmwareButton_Click"/>
                                        <Button x:Name="FirmwareLaterButton" Content="Later" Style="{StaticResource PremiumButton}"
                                                AutomationProperties.Name="Update firmware later" Click="FirmwareLaterButton_Click"/>
                                    </WrapPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- ===================== Troubleshooting ===================== -->
                        <StackPanel x:Name="TroubleshootingContent" Visibility="Collapsed">
                            <TextBlock Text="Troubleshooting" Style="{StaticResource SettingsSectionHeading}"/>
                            <TextBlock Text="Repair and recovery options for your FIFINE SC3." Style="{StaticResource CaptionText}" Margin="0,6,0,20"/>
                            <Border Style="{StaticResource SettingsGroupBorder}">
                                <StackPanel>
                                    <TextBlock Text="Restore original firmware" Style="{StaticResource SettingsGroupHeading}"/>
                                    <TextBlock x:Name="RestoreDescriptionText"
                                               Text="Restore the FIFINE SC3 to the original factory firmware and remove RGB+ support. You will be asked to confirm first."
                                               Style="{StaticResource CaptionText}" Margin="0,6,0,14"/>
                                    <Button x:Name="RestoreButton" Content="Restore Original Firmware…" HorizontalAlignment="Left"
                                            Style="{StaticResource PremiumButton}" BorderBrush="{StaticResource DisconnectedBrush}"
                                            AutomationProperties.Name="Restore original firmware"
                                            AutomationProperties.HelpText="{Binding Text, ElementName=RestoreDescriptionText}"
                                            Click="RestoreButton_Click"/>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>
