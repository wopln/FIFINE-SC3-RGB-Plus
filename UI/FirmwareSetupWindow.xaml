<Window x:Class="SC3RGBController.UI.FirmwareSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SC3 Firmware Update" Width="480" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource WindowBrush}" Foreground="{StaticResource TextBrush}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <StackPanel Margin="28,24,28,24">
        <TextBlock x:Name="HeadingText" Text="Setting up your SC3" Style="{StaticResource PageTitleText}" FontSize="20" TextWrapping="Wrap"/>

        <TextBlock x:Name="StageText" Text="Preparing" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" Margin="0,16,0,0"
                   AutomationProperties.LiveSetting="Polite"/>

        <ProgressBar x:Name="Progress" Height="8" Minimum="0" Maximum="100" Value="0" Margin="0,12,0,0"
                     Background="{StaticResource PressedBrush}" Foreground="{DynamicResource AccentTextBrush}"
                     BorderBrush="{StaticResource ControlStrokeBrush}" BorderThickness="1"
                     AutomationProperties.Name="Firmware progress"/>

        <TextBlock x:Name="DetailText" Text="Do not disconnect the mixer." Style="{StaticResource CaptionText}" FontSize="13"
                   Margin="0,14,0,0" AutomationProperties.LiveSetting="Polite"/>

        <!-- Enabled only when the operation has finished (the window cannot be closed while flashing). -->
        <Button x:Name="CloseButton" Content="Close" MinWidth="100" HorizontalAlignment="Right" Margin="0,24,0,0"
                IsEnabled="False" Style="{StaticResource PremiumButton}" Click="CloseButton_Click"/>
    </StackPanel>
</Window>
