<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Design tokens. Contrast targets (WCAG 2.2): body/secondary text >= 4.5:1 and
         control boundaries/icons >= 3:1 against PanelColor. ThemeManager swaps these
         for system colors when Windows High Contrast is on. -->
    <Color x:Key="WindowColor">#050505</Color>
    <Color x:Key="PanelColor">#0E0E0E</Color>
    <Color x:Key="PanelAltColor">#161616</Color>
    <Color x:Key="InputColor">#0A0A0A</Color>
    <Color x:Key="HoverColor">#202020</Color>
    <Color x:Key="PressedColor">#2A2A2A</Color>
    <Color x:Key="TextColor">#F5F5F5</Color>
    <Color x:Key="SecondaryTextColor">#B8B8B8</Color>
    <!-- #8A8A8A keeps small hint text at ~5.6:1 on panels (was #676767, ~3.5:1). -->
    <Color x:Key="MutedColor">#8A8A8A</Color>
    <Color x:Key="BorderColor">#262626</Color>
    <Color x:Key="ControlStrokeColor">#6A6A6A</Color>
    <Color x:Key="AccentColor">#FF7800</Color>

    <SolidColorBrush x:Key="WindowBrush" Color="{StaticResource WindowColor}" />
    <SolidColorBrush x:Key="PanelBrush" Color="{StaticResource PanelColor}" />
    <SolidColorBrush x:Key="PanelAltBrush" Color="{StaticResource PanelAltColor}" />
    <SolidColorBrush x:Key="InputBrush" Color="{StaticResource InputColor}" />
    <SolidColorBrush x:Key="HoverBrush" Color="{StaticResource HoverColor}" />
    <SolidColorBrush x:Key="PressedBrush" Color="{StaticResource PressedColor}" />
    <SolidColorBrush x:Key="TextBrush" Color="{StaticResource TextColor}" />
    <SolidColorBrush x:Key="SecondaryTextBrush" Color="{StaticResource SecondaryTextColor}" />
    <SolidColorBrush x:Key="MutedBrush" Color="{StaticResource MutedColor}" />
    <SolidColorBrush x:Key="BorderBrush" Color="{StaticResource BorderColor}" />
    <SolidColorBrush x:Key="ControlStrokeBrush" Color="{StaticResource ControlStrokeColor}" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}" />
    <!-- Updated with AccentBrush at runtime: content on the accent, and the accent as readable text/outline on dark panels. -->
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#000000" />
    <SolidColorBrush x:Key="AccentTextBrush" Color="{StaticResource AccentColor}" />

    <SolidColorBrush x:Key="ConnectedBrush" Color="#4EE978" />
    <SolidColorBrush x:Key="DisconnectedBrush" Color="#FF6B78" />
    <SolidColorBrush x:Key="WarningBrush" Color="#FFB547" />
    <SolidColorBrush x:Key="InfoBarBackgroundBrush" Color="#1A1A1A" />
    <SolidColorBrush x:Key="WarningBarBackgroundBrush" Color="#221A0C" />
    <SolidColorBrush x:Key="SuccessBarBackgroundBrush" Color="#0E1A12" />
</ResourceDictionary>
